whatsapp-booking-mvp.duckdns.org {
    @whatsapp_webhook_post {
        method POST
        path /api/v1/webhooks/whatsapp
    }
    request_body @whatsapp_webhook_post {
        max_size 1MiB
    }
    @google_admin_auth_post {
        method POST
        path /api/v1/admin/google/session /api/v1/admin/google/link
    }
    request_body @google_admin_auth_post {
        max_size 32KiB
    }
    @embedded_signup_complete {
        method POST
        path /api/v1/admin/whatsapp/embedded-signup/complete
    }
    request_body @embedded_signup_complete {
        max_size 16KiB
    }

    reverse_proxy api:8000
}
